# Copy to .env for local runs. The real .env is git-ignored (see repo .gitignore).
# In-cluster these come from the Secret, not this file — see
# gc-industries-devops-superheros/platform/ai/secret.example.yaml.

# Required for enrichment. Without it the service still forwards plain,
# un-enriched alerts to Slack (it degrades, it does not crash).
OPENAI_API_KEY=<your-openai-api-key>

# Required to deliver anything. A Slack incoming-webhook URL.
SLACK_WEBHOOK_URL=<your-slack-incoming-webhook-url>

# Optional overrides (defaults shown).
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT=20
# SLACK_TIMEOUT=10
# OPENAI_MAX_TOKENS=400
# AI_ENRICH_ENABLED=true      # set false to forward alerts without calling the model
# LOG_LEVEL=INFO
